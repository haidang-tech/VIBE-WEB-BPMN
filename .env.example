# Copy file này thành .env rồi điền giá trị thật.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/due_blood?schema=public"

# Khóa mã hóa PII (CCCD) - 32 bytes dạng base64
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""
# Khóa HMAC cho blind index - 32 bytes dạng base64 (sinh như trên)
PII_BLIND_INDEX_KEY=""

# JWT secret - tối thiểu 32 ký tự, nên là 48 byte base64 ngẫu nhiên
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Thời hạn phiên đăng nhập (giây). Mặc định 8 giờ.
SESSION_TTL_SECONDS=28800

# Cookie Secure: chỉ đặt false khi test HTTP trên host KHÔNG phải localhost.
COOKIE_SECURE=true

# Secret dùng cho endpoint audit nội bộ (middleware gọi khi chặn truy cập)
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUDIT_INTERNAL_SECRET=""

# --- AI hỗ trợ sàng lọc ghi chú sức khỏe (tuỳ chọn) -----------------------
# Bỏ trống AI_API_KEY để chỉ dùng bộ quy tắc y tế nội bộ (hoạt động offline).
# API tương thích OpenAI: có thể trỏ tới OpenAI, Azure OpenAI, Gemini, Ollama...
# Ví dụ Google Gemini:
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_MODEL="gemini-2.5-flash"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Thời gian chờ tối đa (ms). Hết thời gian sẽ tự quay về quy tắc nội bộ.
# Gemini thường phản hồi 3-6 giây nên đặt 8000 khi dùng Gemini.
AI_TIMEOUT_MS=4000
